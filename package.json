{
  "name": "document-builder",
  "private": true,
  "version": "0.1.0-pre.1",
  "description": "Local-first New Product Introduction document builder with optional AI assistance",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win-dir": "npm run build && electron-builder --win dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:all": "npm run build && electron-builder -mwl",
    "test:ai": "node --experimental-strip-types --test tests/ai.test.mjs tests/electron-security.test.cjs",
    "test:ui": "playwright test"
  },
  "build": {
    "appId": "com.productdeveloper.npi-document-builder",
    "productName": "NPI Builder",
    "icon": "public/npi-builder-logo.ico",
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/npi-builder-logo.jpg",
      "electron/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/npi-builder-logo.jpg",
        "to": "npi-builder-logo.jpg"
      },
      {
        "from": "public/npi-builder-logo.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "public/npi-builder-logo.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NPI-Document-Builder-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "NPI-Document-Builder-${version}-${arch}.${ext}",
      "category": "Utility"
    },
    "portable": {
      "artifactName": "NPI-Document-Builder-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}